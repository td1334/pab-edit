MEMEND $F300SCREEN $F400CHARSET $F800MARK $4B6 $4B6ON 0 $00ON 1 $00ON 2 $00ON 3 $00ON 4 $00ON 5 $00ON 6 $00ON 7 $00ON 8 $00ON 9 $00SYSTEM $00FILL $F380, $F3FF, 0SPRINDEX 206SPRDATA %111100011100111100000000SPRDATA %000110000110000110000000SPRDATA %111100111110111100111110SPRDATA %110000110110110110000000SPRDATA %110000110110111100000000SPRINDEX 207SPRDATA %111110111100110111100000SPRDATA %000000000110000000110000SPRDATA %111100110110110000110000SPRDATA %110000110110110000110000SPRDATA %111110111100110000110000FUNCTION SHOW_ERROR() CALL SHOW_INFO("ERROR: ("+ STR$( ST( ))+") "+ CHR$( 13)+ DISK , 0)ENDFUNC FUNCTION SAVE_CONFIG(FILE$) INK CFG%(3) PRINTXY 0, 24,  CHR$( $0F);"SAVING CONFIG .. PLEASE WAIT ..."; CALL SPRITES_OFF() DISK "S:"+FILE$ BSAVE FILE$+",S,W",  VARADDR( CFG%(0)),  VARADDR( CFG%(0))+CFGSIZE%, 1 IF ST( ) AND %0000000010111111 THEN CALL SHOW_ERROR() CALL SPRITES_ON()ENDFUNC FUNCTION LOAD_CONFIG(FILE$, VAL%) X% =  POSX()  Y% =  POSY()  INK CFG%(3) PRINTXY 0, 24,  CHR$( $0F);"LOADING CONFIG .. PLEASE WAIT ..."; CALL SPRITES_OFF() IF NOT BLOAD FILE$+",S,R",  VARADDR( CFG%(0)), 0  CALL SHOW_ERROR() ELSE   PRINTXY 0, 24,  CHR$( $0F);"INIT CONFIG .. PLEASE WAIT ...";  IF NOT BIT( 0, VAL%) THEN CALL INIT()  IF NOT BIT( 1, VAL%) THEN CALL CREATE_FONT(1) ENDIF  CALL SPRITES_ON() CURXY X%, Y% COLOR CFG%(0), CFG%(1)ENDFUNC FUNCTION FILEEXISTS(DRIVE%, FILE$) CLOSE 126 OPEN 126, DRIVE%, 0, FILE$+",S,R": GET# 126, V2$: CLOSE 126 FE% =  ST( ) = 0 IF NOT FE% THEN DISK  RETURN FE%ENDFUNC   FUNCTION GET_FILENAME(V1$, V2$) V1% =  INK  INK CFG%(3) PRINTXY 0, 24,  CHR$( 15); PRINT UCASE$( V1$); V2$ =  INPUT 16#V2$!3 PRINT CHR$( $92); INK V1% RETURN V2$ENDFUNC FUNCTION CHECK_DRIVE(A1%) OPEN 126, A1%, 0: CLOSE 126 RETURN NOT ST( )ENDFUNC FUNCTION REFRESH_SCREEN() V1% = BASE%+TOPZEILE%*40 RCOPY V1%, V1%+960,  SCREEN ENDFUNC FUNCTION GET_ADRESSE(SPALTE%) RETURN BASE%+TOPZEILE%*40+YPOS%*40+ IIF( SPALTE%, XPOS%, 0)ENDFUNC FUNCTION GET_ADRESSE_SPALTE() RETURN CALL GET_ADRESSE(1)ENDFUNC FUNCTION GET_ADRESSE_ZEILE() RETURN CALL GET_ADRESSE(0)ENDFUNC FUNCTION INSERT_LINE() ADR% = BASEEND%-40 RTPOKE VARADDR( A$(0)),  SHIFTL( 8, ADR%)+$28 IF A$(0) = LEER$  IF ZEILE% < MAXZEILEN%-1   ADR% =  CALL GET_ADRESSE_ZEILE()   RCOPY ADR%, BASEEND%-40, ADR%+40   RCOPY LENADR%+ZEILE%, LENEND%-1, LENADR%+ZEILE%+1  ENDIF   FILL ADR%, ADR%+39, 32  LEN%(ZEILE%) = 0  IF YPOS% < SCREENZEILEN%-1   SCRCOPY 0, YPOS%, 40, SCREENZEILEN%-YPOS%-1, 0, YPOS%+1  ENDIF   RCOPY ADR%, ADR%+40,  SCREEN +YPOS%*40  IF (SP1% <= SP2%) AND SP1% >= 0   IF ZEILE% < SP1% THEN VADD SP1%, 1   IF ZEILE% <= SP2% THEN VADD SP2%, 1   ENDIF   ENDIF  ENDIF ENDFUNC FUNCTION DELETE_LINE()  IF ZEILE% < MAXZEILEN%-1   ADR% =  CALL GET_ADRESSE_ZEILE()   RCOPY ADR%+40, BASEEND%, ADR%   RCOPY LENADR%+ZEILE%+1, LENEND%, LENADR%+ZEILE%  ENDIF   FILL BASEEND%-40, BASEEND%-1, 32  LEN%(MAXZEILEN%-1) = 0    IF YPOS% < SCREENZEILEN%-1   SCRCOPY 0, YPOS%+1, 40, SCREENZEILEN%-YPOS%-1, 0, YPOS%  ENDIF   ADR% = (TOPZEILE%+SCREENZEILEN%-1)*40+BASE%  RCOPY ADR%, ADR%+40,  SCREEN +(SCREENZEILEN%-1)*40  IF ZEILE% < SP1% THEN VSUB SP1%, 1  IF ZEILE% <= SP2% THEN VSUB SP2%, 1  IF SP2% < SP1% THEN SP1% =  LET SP2% = -1ENDFUNC FUNCTION REFRESH_INFOS() REFRESHINFOS% = 0 V1% =  INK  INK CFG%(3) PRINTXY 0, 24,  UCASE$( "ROW "); PRINT PADR$( 4,  STR$( ZEILE%+1)); PRINT UCASE$( "COL "); PRINT PADR$( 2,  STR$( XPOS%+1)); PRINT UCASE$( " DRV "); PRINT PADR$( 2,  STR$( LW%)); PRINT UCASE$( IIF( CFG%(13), " PRG", " SEQ")); PRINT UCASE$( IIF( CFG%(14), " OVR", " INS")); PRINT UCASE$( IIF( CFG%(12), " UML ", " SYM ")); INK V1%ENDFUNC FUNCTION SHOW_INFO(V1$, V1%) SCRCLR  SCRCHARS $F0, $C0, $EE, $DD, $20, $DD, $ED, $C0, $FD SCRBOX 5, 7, 30, 9, 12 SCRWINDOW 6, 8, 28, 7, 3 INK CFG%(2) PRINT UCASE$( V1$) CURXY 19,5  IF V1%  PRINT UCASE$( "YES / NO")  INK CFG%(3)  PRINTXY 19, 5,  UCASE$( "YN") ELSE  INK CFG%(3)  PRINT RIGHT(UCASE$("PRESS ANY KEY")); ENDIF GETKEY A$,  IIF( V1%, "YN", 0) SCRWINDOW OFF  INK CFG%(2) SCRCLR  CALL REFRESH_SCREEN() CALL REFRESH_INFOS() RETURN A$ = "Y"ENDFUNC  FUNCTION LOAD_TEXT(LFILE$) CALL SPRITES_OFF() COLOR CFG%(0), CFG%(1) FILL BASE%, BASEEND%-1, $20 FILL LENADR%, LENEND%-1, 0  OPEN 1, LW%, 2, LFILE$+","+ IIF( CFG%(13), "P", "S")+",R" IF CFG%(13) THEN GET# 1: GET# 1 ZEILE% = 0 TOPZEILE% = 0 XPOS% = 0 XP% = 0 REPEAT   INPUT# 1, ZEILE$  FOR X% = 0 TO ( LEN( ZEILE$)-1)/40   A$ =  RTRIM$( SUBSTR$( X%*40, 40, ZEILE$))   IF ZEILE% < MAXZEILEN%    ADR% =  VARADDR( A$)    LEN% =  MIN( 40,  LEN( A$))    RCOPY ADR%, ADR%+LEN%, BASE%+ZEILE%*40    LEN%(ZEILE%) = LEN%    IF ZEILE% < SCREENZEILEN%     RCOPY ADR%, ADR%+LEN%,  SCREEN +ZEILE%*40    ENDIF    ELSE     EXIT 2   ENDIF    CALL REFRESH_INFOS()   VADD ZEILE%, 1  NEXT  UNTIL ( ST( ) <> 0) IF ST( ) = 0 THEN CALL SHOW_INFO("ATTENTION, FILE LARGER THAN TEXT BUFFER", 0) IF ST( ) > 64 THEN CALL NEW_TEXT(): CALL SHOW_ERROR() CLOSE 1 FILE$ = LFILE$+".CFG" IF CALL FILEEXISTS(LW%,  FILE$ )  IF CALL SHOW_INFO("CONFIG FILE FOUND!"+ CHR$( 13)+ CHR$( 13)+"FOUND: "+FILE$+ CHR$( 13)+ CHR$( 13)+"LOAD?", -1)    CALL LOAD_CONFIG(FILE$, 0)  ENDIF  ENDIF   TOPZEILE% = 0 ZEILE% = 0 YPOS% = 0 XPOS% = 0 XP% = 0 SP1% =  LET SP2% = -1 WORDWRAP% = 0 CALL REFRESH_SCREEN() CALL SPRITES_ON()ENDFUNC FUNCTION SAVE_TEXT(SFILE$) CALL SPRITES_OFF() ARR% =  VARADDR( A$(0)) FOR Y% = MAXZEILEN%-1 TO 1 STEP -1  ADR% = BASE%+Y%*40  RTPOKE ARR%,  SHIFTL( 8, ADR%)+$28  IF A$(0) <> LEER$ THEN EXIT  NEXT  V2$ = "PAB-EDIT-TEMP" DISK "S:"+V2$ DISK "R:"+V2$+"="+SFILE$ DISK "S:"+SFILE$ OPEN 1, LW%, 2, SFILE$+","+ IIF( CFG%(13), "P", "S")+",W" IF CFG%(13) THEN PRINT# 1,  CHR$( 0)+ CHR$( 4) FOR X% = 0 TO Y%  ADR% = BASE%+X%*40  RTPOKE VARADDR( A$(0)),  SHIFTL( 8, ADR%)+$28  PRINT# 1,  RTRIM$( A$(0))+ CHR$( 13)  IF ST( ) THEN EXIT ;  PRINTXY 0, 24, X%;"-";Y%;"   "; NEXT  CLOSE 1 ST% =  ST( ) AND %0000000010111111 IF (ST% = 0)  FILE$ = SFILE$+".CFG"  IF CALL SHOW_INFO("SAVE CONFIG FILE?"+ CHR$( 13)+ CHR$( 13)+"FILE: "+FILE$, -1)    CALL SAVE_CONFIG(FILE$)  ENDIF  ELSE   CALL SHOW_ERROR()  DISK "R:"+SFILE$+"="+V2$  SCRCLR   PRINTXY 0, 11,  UCASE$( "SAVE ERROR:"+A$), ERR%, ST%  PRINTXY 0, 12,  UCASE$( "FILE '"+SFILE$+"' NOT SAVED!")  PRINTXY 0, 14,  UCASE$( "PRESS ANY KEY TO CONTINUE...")  GETKEY A$, 0  CALL REFRESH_SCREEN() ENDIF  CALL SPRITES_ON()ENDFUNC FUNCTION CURSOR_RUNTER() IF YPOS% < SCREENZEILEN%-1  VADD YPOS%, 1 ELSE   REM SCROLLING NACH OBEN  IF ZEILE% < MAXZEILEN%-1   VADD TOPZEILE%, 1   CALL REFRESH_SCREEN()  ENDIF  ENDIF  WORDWRAP% = 0 REFRESHINFOS% = 1 ZEILE% = TOPZEILE%+YPOS%ENDFUNC FUNCTION CURSOR_HOCH() IF YPOS% > 0  VSUB YPOS%, 1 ELSE   REM SCROLLING NACH UNTEN  IF TOPZEILE% > 0   VSUB TOPZEILE%, 1   CALL REFRESH_SCREEN()  ENDIF  ENDIF  WORDWRAP% = 0 REFRESHINFOS% = 1 ZEILE% = TOPZEILE%+YPOS%ENDFUNC FUNCTION CURSOR_RECHTS() IF (XPOS% = LEN%(ZEILE%)) OR XPOS% = 39  IF ZEILE%+1 < MAXZEILEN%   XPOS% = 0   CALL CURSOR_RUNTER()  ENDIF  ELSE   VADD XPOS%, 1 ENDIF  XP% = XPOS% WORDWRAP% = 0 REFRESHINFOS% = 1ENDFUNC FUNCTION CREATE_FONT(V1%) IF V1% = 0  V2% =  POSY()   V3% =  INK   INK CFG%(3)  PRINTXY 0, 24,  CHR$( 15);"CREATE FONT"; ENDIF  OFFSET% =  IIF( CFG%(4), 1, 0) IF REUFONT%(OFFSET%)  TEST(   REUREAD $800+OFFSET%*$800,  CHARSET , $7F8 ELSE   SETRAMROM 2  ORGFONT% = $D000+OFFSET%*$800  FOR X% = 0 TO 254   ALT% = ORGFONT%+SS%(X%)*8   NEU% = ( CHARSET )+X%*8   RCOPY ALT%, ALT%+8, NEU%   IF V1% = -1 THEN IF NOT MOD( X%, 8) THEN PRINT "-";   IF X% = 160 THEN FILL ( CHARSET )+160*8, ( CHARSET )+160*8+7, $FF  NEXT   SETRAMROM 0  IF V1% = 0   PRINTXY 0, 24,  CHR$( 15);   CURY V2%   INK V3%  ENDIF   IF REUEXISTS() AND NOT REUFONT%(OFFSET%)   REUFONT%(OFFSET%) = -1   REUWRITE $800+OFFSET%*$800,  CHARSET , $7F8  ENDIF  ENDIF   IF CFG%(12)  CHARINDEX CFG%(5)  CHARDATA %00000000  CHARDATA %00111100  CHARDATA %01100110  CHARDATA %01101100  CHARDATA %01100110  CHARDATA %01100110  CHARDATA %01101100  CHARDATA %00000000  GROSS% =  IIF( CFG%(4), 0, 3)  CHARINDEX CFG%(6)  CHARDATA %01100110  CHARDATA %00000000  CHARDATA %00111100  CHARDATA %00000110  CHARDATA %00111110  CHARDATA %01100110  CHARDATA %00111110  CHARDATA %00000000  CHARINDEX CFG%(7)  CHARDATA %01100110  CHARDATA %00000000  CHARDATA %00111100  CHARDATA %01100110  CHARDATA %01100110  CHARDATA %01100110  CHARDATA %00111100  CHARDATA %00000000  CHARINDEX CFG%(8)  CHARDATA %00000000  CHARDATA %01100110  CHARDATA %00000000  CHARDATA %01100110  CHARDATA %01100110  CHARDATA %01100110  CHARDATA %00111110  CHARDATA %00000000  CHARINDEX CFG%(9-GROSS%)  CHARDATA %01100110  CHARDATA %00111100  CHARDATA %01100110  CHARDATA %01100110  CHARDATA %01111110  CHARDATA %01100110  CHARDATA %01100110  CHARDATA %00000000  CHARINDEX CFG%(10-GROSS%)  CHARDATA %01100110  CHARDATA %00111100  CHARDATA %01100110  CHARDATA %01100110  CHARDATA %01100110  CHARDATA %01100110  CHARDATA %00111100  CHARDATA %00000000  CHARINDEX CFG%(11-GROSS%)  CHARDATA %01100110  CHARDATA %00000000  CHARDATA %01100110  CHARDATA %01100110  CHARDATA %01100110  CHARDATA %01100110  CHARDATA %00111100  CHARDATA %00000000 ENDIF   REFRESHINFOS% = 1ENDFUNC FUNCTION SPRITES_OFF() SPRENGINE OFF  SPLIT OFF  SLEEP( 2)ENDFUNC FUNCTION SPRITES_ON() SPRENGINE ON  SPLIT ON ENDFUNC FUNCTION BERECHNE_ZEILENLAENGE(V1%) ADR% = BASE%+V1%*40+40 FOR X% = 0 TO 39  IF RPEEK( --ADR%) <> 32 THEN EXIT  NEXT  LEN%(V1%) = 40-X%ENDFUNC FUNCTION INIT() SCRWINDOW OFF  COLOR CFG%(0), CFG%(1) CHARSET IIF( CFG%(4), 1, 0) INK CFG%(2) SCRCLR  IF CFG%(1) = 0 THEN SPRCOLOR 0, 15, 15, 11, 11 IF CFG%(1) = 1 THEN SPRCOLOR 0, 14, 14, 6, 6 IF CFG%(1) >= 2 THEN SPRCOLOR 0, 1, 1, 0, 0ENDFUNC FUNCTION NEW_TEXT() FILL BASE%, BASEEND%-1, $20 FILL LENADR%, LENEND%-1, 0 TOPZEILE% = 0 XPOS% = 0 YPOS% = 0ENDFUNC FUNCTION REU_SAVECHARSET() IF REUEXISTS()   REUWRITE 0,  CHARSET , $7F8 ENDIF ENDFUNC FUNCTION REU_LOADCHARSET() IF REUEXISTS()   REUREAD 0,  CHARSET , $7F8 ENDIF ENDFUNC BREAK OFF DIM CFG%(2, 20), CFG2%(2, 20)CFG%(0) = 12CFG%(1) = 11CFG%(2) = 15CFG%(3) = 7CFG%(4) = 1: REM CHARSETCFG%(5) = 161CFG%(6) = 162CFG%(7) = 163CFG%(8) = 164CFG%(9) = 165CFG%(10) = 166CFG%(11) = 167CFG%(12) = -1: REM UMLAUTSCFG%(13) = 0: REM 0 = SEQ, <0> = PRGCFG%(14) = -1: REM 0 = INS, <0> = OVRCFGSIZE% = 15*2DIM REUFONT%(1, 2)LW% =  DISK -1SETRAMROM 0KEYSETTINGS( 16, 2)DIM UM_TEXT$(7)RESTORE UMLAUTEFOR X% = 0 TO 6 UM_TEXT$(X%) =  READ NEXT DATA UMLAUTEDATA "ÓÓ"DATA "ÌOWER AE"DATA "ÌOWER OE"DATA "ÌOWER UE"DATA "ÕPPER AE"DATA "ÕPPER OE"DATA "ÕPPER UE"DIM S%(2, 8)RESTORE SCRCODEFOR X% = 0 TO 7 S%(X%) =  READ NEXT DATA SCRCODEDATA $80, $00, $40, $20, $40, $C0, $80, $80LOADNAME$ =  IIF( RPEEK( $832), "", "KURZGESCHICHTE")CFGNAME$ = "PAB-EDIT.CFG"IF CALL FILEEXISTS(LW%, CFGNAME$) PRINTXY 0, 24, "AUTOLOAD CONFIG"; CALL LOAD_CONFIG(CFGNAME$, %00000011) SPLIT OFF ENDIF CALL INIT()PRINT UCASE$( "PAB EDIT V1.8")PRINT STRING$( 39, "-")PRINT PRINT PRINT UCASE$( "CREATE ARRAY PETSCII <> SCREENCODE")PRINT "["; STRING$( 32, 32);"]"; CURX 1;DIM SS%(2, 256)FOR X% = 0 TO 255 SS%(X%) = X% XOR S%(X%/32) IF MOD( X%, 8) = 0 THEN PRINT "-";NEXT SS%($FF) = $5EPRINTXY 0, 8,  UCASE$( "CREATE FONT")PRINT "["; STRING$( 32, 32);"]"; CURX 1;CALL CREATE_FONT(-1)X% = 274Y% = 194CALL SPRITES_ON()SPRSET 0, 206, 207, 206, 207SPRY 0, Y%, Y%++, Y%, Y%SPRX 0, X%, X%+24, X%+1, X%+25 PRINT PRINT MAXZEILEN% = ( FREE( 1)-256)/45DIM PUFFER%(1, MAXZEILEN%*40)BASE% =  VARADDR( PUFFER%(0))BASEEND% = BASE%+MAXZEILEN%*40DIM LEN%(1, MAXZEILEN%)LENADR% =  VARADDR( LEN%(0))LENEND% =  VARADDR( LEN%(MAXZEILEN%-1))+1FILL BASE%, BASEEND%-1, $20DIM ZEILE40%(1, 40)ZEILE40% =  VARADDR( ZEILE40%(0))DIM A$(1)SPLIT 25, 0, 0,  SCREEN ,  CHARSET , CFG%(0), CFG%(1)LEER$ =  STRING$( 40, $20)SCRCLR XPOS% = 0XP% = 0YPOS% = 0TOPZEILE% = 0SCREENZEILEN% = 24REFRESHINFOS% = 1CALL REFRESH_SCREEN()CURY 0SP1% = -1SP2% = -1SPMARK% = -1SPMARK1% = 0SPMARK2% = 0AA% = 8REPEAT  ZEILE% = TOPZEILE%+YPOS% Y1% = SP1%-TOPZEILE% IF Y1% >= SCREENZEILEN%  Y1% = 25  Y2% = 24 ELSE   IF Y1% < 0 THEN Y1% = 0  Y2% = SP2%-TOPZEILE%  IF Y2% < 0 THEN Y1% = 25:Y2% = 24  IF Y2% > 23 THEN Y2% = 23 ENDIF   SPLIT Y1%, 0, 0,  SCREEN ,  CHARSET , 14, 6, Y2%+1, 0, 0,  SCREEN ,  CHARSET , CFG%(0), CFG%(1) IF AA% <> 0  AA% = 0  A% = 8  KEYS% = 4 ELSE   A% = 0  RF% = 0  ADR% =  SCREEN +XPOS%+YPOS%*40  COL% = $D800+XPOS%+YPOS%*40  SETRAMROM 0  SC% =  RPEEK( ADR%)  SETRAMROM 1  CC% =  RPEEK( COL%)  SETRAMROM 0    GETKEY A%  IF A% = 0   REPEAT     VRPOKE ADR%, 160    SETRAMROM 1    VRPOKE COL%, CFG%(3)    SETRAMROM 0    T% = TI%+16    REPEAT     GETKEY A%    UNTIL (A% <> 0) OR TI% >= T%    IF A% <> 0 THEN EXIT     VRPOKE ADR%, SC%    SETRAMROM 1    VRPOKE COL%, CFG%(2)    SETRAMROM 0    T% = TI%+16    REPEAT      GETKEY A%    UNTIL (A% <> 0) OR TI% >= T%    IF A% <> 0 THEN EXIT     VADD RF%, 1    IF (RF% = 1) AND REFRESHINFOS%     RF% = 0     CALL REFRESH_INFOS()    ENDIF    UNTIL A% <> 0  ENDIF   KEYS% =  RPEEK( $28D) AND 7  VRPOKE ADR%, SC%  SETRAMROM 1  VRPOKE COL%, CC%  SETRAMROM 0 ENDIF  A$ =  CHR$( A%)IF NOT RPEEK( $832) INK CFG%(3) PRINTXY 30, 24,  UCASE$( "A:"); HEX$( A%); INK CFG%(2)ENDIF  DOCASE   CASE A% = $15 AND KEYS% = 4 AND CFG%(12) <> 0: REM CTRL+U - UMLAUTE ERZEUGEN   COLOR CFG%(0)+8   GETKEY A%, 0   C% = -1   DOCASE     CASE A% = $41:C% = 6: BREAK     CASE A% = $4F:C% = 7: BREAK     CASE A% = $55:C% = 8: BREAK     CASE A% = $C1:C% = 9: BREAK     CASE A% = $CF:C% = 10: BREAK     CASE A% = $D5:C% = 11: BREAK     CASE A% = $53:C% = 5: BREAK    ENDCASE    COLOR CFG%(0)   IF C% = -1    A% = 0   ELSE     A% = CFG%(C%)   ENDIF     CASE (A% >= 32 AND A% < 128) OR A% >= 160   IF ZEILE% > 0 AND XPOS% = 0 AND WORDWRAP%    ADR% =  CALL GET_ADRESSE_ZEILE()    RTPOKE VARADDR( A$(0)),  SHIFTL( 8, ADR%-40)+$28    FOR X% = 0 TO 39     IF INLIST( RPEEK( --ADR%), 32, 33, 44, 46, 58, 59, 63) THEN EXIT    NEXT    REM PRINTXY 10,10,X%    IF X% > 0 AND X% <40     IF NOT CFG%(14) THEN CALL INSERT_LINE()     ADR% = BASE%+ZEILE%*40     RCOPY ADR%-X%, ADR%, ADR%     RCOPY ADR%-X%, ADR%,  SCREEN +YPOS%*40     FILL ADR%-X%, ADR%-1, $20     RCOPY ADR%-40, ADR%,  SCREEN +YPOS%*40-40     IF CFG%(14) THEN RCOPY ADR%, ADR%+40,  SCREEN +YPOS%*40     XPOS% = X%    ENDIF   ENDIF    IF NOT CFG%(14)    ADR% =  CALL GET_ADRESSE_ZEILE()    IF RPEEK( ADR%+39) <> 32 THEN BREAK      RCOPY ADR%+XPOS%, ADR%+39, ADR%+XPOS%+1     LEN%(ZEILE%) = LEN%(ZEILE%)+1     ADRS% =  SCREEN +YPOS%*40     RCOPY ADR%+XPOS%, ADR%+40,  SCREEN +YPOS%*40+XPOS%   ENDIF    ADR% =  CALL GET_ADRESSE_ZEILE()   RPOKE ADR%+XPOS%, A%   RPOKE SCREEN +XPOS%+YPOS%*40, A%   IF XPOS%+1 >= LEN%(ZEILE%)    LEN%(ZEILE%) = XPOS%+1   ENDIF    CALL CURSOR_RECHTS()   WORDWRAP% = A% <> 32   REFRESHINFOS% = 1   XP% = XPOS%   BREAK    REM    REM KEIN SONDERTASTEN WIE CTRL, SHTFT ODER COMM   REM    CASE KEYS% = 0    DOCASE      CASE A% = $13: REM HOME     XPOS% = LET XP% = 0     REFRESHINFOS% = 1     BREAK      CASE A% = $1D: REM RECHTS     CALL CURSOR_RECHTS()     BREAK      CASE A% = $11: REM RUNTER      CALL CURSOR_RUNTER()      XPOS% =  MIN( XP%, LEN%(ZEILE%))      BREAK      CASE A% = $14: REM DEL      IF XPOS% > 0       ADR% =  CALL GET_ADRESSE_ZEILE()       RCOPY ADR%+XPOS%, ADR%+40, ADR%+XPOS%-1       RPOKE ADR%+39, 32       RCOPY ADR%, ADR%+40,  SCREEN +YPOS%*40       VSUB XPOS%, 1       LEN%(ZEILE%) = LEN%(ZEILE%)-1       REFRESHINFOS% = 1      ELSE        IF ZEILE% > 0        MAX% = LEN%(ZEILE%)+LEN%(ZEILE%-1)        IF MAX% <= 40         ADR% =  CALL GET_ADRESSE_ZEILE()         RCOPY ADR%, ADR%+LEN%(ZEILE%), ADR%-40+LEN%(ZEILE%-1)         XPOS% = LEN%(ZEILE%-1)         CALL DELETE_LINE()         CALL CURSOR_HOCH()         ADR% =  CALL GET_ADRESSE_ZEILE()         RCOPY ADR%, ADR%+40,  SCREEN +YPOS%*40         LEN%(ZEILE%) = MAX%        ENDIF        ENDIF       ENDIF       BREAK      CASE A% = $0D: REM RETURN      CALL CURSOR_RUNTER()      XPOS% = 0      XP% = 0      BREAK     ENDCASE     BREAK    REM    REM SHIFT   REM    CASE KEYS% = 1    DOCASE      CASE A% = $93: REM CLR     XPOS% = LET XP% = 0     TOPZEILE% = 0     YPOS% = 0     CALL REFRESH_SCREEN()     REFRESHINFOS% = 1     BREAK      CASE A% = $9D: REM LINKS      IF XPOS% > 0       VSUB XPOS%, 1      ELSE        IF ZEILE% > 0        CALL CURSOR_HOCH()        XPOS% =  MIN( 39, LEN%(ZEILE%))       ENDIF       ENDIF       REFRESHINFOS% = 1      XP% = XPOS%      BREAK      CASE A% = $91: REM HOCH      CALL CURSOR_HOCH()      XPOS% =  MIN( XP%, LEN%(ZEILE%))      BREAK      CASE A% = $94: REM SHIFT+DEL      IF XPOS% < 39       ADR% =  CALL GET_ADRESSE_ZEILE()       IF RPEEK( ADR%+39) = 32        RCOPY ADR%+XPOS%, ADR%+39, ADR%+XPOS%+1        RPOKE ADR%+XPOS%, 32        RCOPY ADR%, ADR%+40,  SCREEN +YPOS%*40        LEN%(ZEILE%) = LEN%(ZEILE%)+1        REFRESHINFOS% = 1       ENDIF       ENDIF       BREAK      CASE A% = $8D: REM SHIFT + RETURN      ADR% = BASEEND%      FOR FREI% = 0 TO 79       IF RPEEK( --ADR%) <> 32 THEN EXIT       NEXT       IF FREI% < 40 THEN BREAK       IF XPOS% = 0       CALL INSERT_LINE()      ELSE        ADR% =  CALL GET_ADRESSE_SPALTE()       ADRZ% =  CALL GET_ADRESSE_ZEILE()       X1% = 40-XPOS%       A$ =  CALL GET_STRING_FROM_ADR(ADR%, 40-XPOS%)       A% =  LEN( A$)       RCOPY ADRZ%+40, BASEEND%-40, ADRZ%+80       RCOPY LENADR%+ZEILE%, LENEND%-2, LENADR%+ZEILE%+1       RCOPY ADRZ%+XPOS%, ADRZ%+40, ADRZ%+40       FILL ADRZ%+XPOS%, ADRZ%+39, $20       FILL ADRZ%+40+A%, ADRZ%+79, $20       CALL REFRESH_SCREEN()       CALL BERECHNE_ZEILENLAENGE(ZEILE%)       CALL BERECHNE_ZEILENLAENGE(ZEILE%+1)      ENDIF       XPOS% = 0      XP% = 0      CALL CURSOR_RUNTER()      BREAK     ENDCASE     BREAK    REM    REM COMMODORE   REM    CASE KEYS% = 2    DOCASE     CASE A% = $93: REM CLR     XPOS% = LET XP% = 0     YPOS% = 0     CALL REFRESH_SCREEN()     REFRESHINFOS% = 1     BREAK    ENDCASE    BREAK       REM    REM CTRL   REM    CASE KEYS% = 4    DOCASE      CASE A% = 9: REM CTRL+I = INSERT LINE      CALL INSERT_LINE()      BREAK         CASE A% = 4: REM CTRL+D = DELETE LINE      CALL DELETE_LINE()      BREAK         CASE A% = 12: REM CTRL+L = LOAD TEXT      V1$ =  CALL GET_FILENAME("LOAD FILE: ", LOADNAME$)      IF ST( ) = 0       LOADNAME$ = V1$       IF NOT EMPTY( V1$) THEN CALL LOAD_TEXT(LOADNAME$)      ENDIF       REFRESHINFOS% = 1      BREAK      CASE A% = $13: REM CTRL+S = SAVE TEXT      V1$ =  CALL GET_FILENAME("SAVE FILE: ", SAVENAME$)      IF ST( ) = 0       SAVENAME$ = V1$       CALL SAVE_TEXT(SAVENAME$)      ENDIF       REFRESHINFOS% = 1      BREAK          CASE A% = 2: REM CTRL+B = CLR LINE TO BEGIN      ADR% =  CALL GET_ADRESSE_ZEILE()      FILL ADR%, ADR%+XPOS%, 32      RCOPY ADR%, ADR%+40,  SCREEN +YPOS%*40      BREAK          CASE A% = 5: REM CTRL+E = CLR LINE TO END      ADR% =  CALL GET_ADRESSE_ZEILE()      FILL ADR%+XPOS%, ADR%+39, 32      RCOPY ADR%, ADR%+40,  SCREEN +YPOS%*40      LEN%(ZEILE%) = XPOS%      BREAK          CASE A% = 8: REM CTRL+H = HELP      CALL SHOW_HELP()      CALL REFRESH_SCREEN()      REFRESHINFOS% = 1      BREAK      CASE A% = 144: REM CTRL + 1 = LAUFWERK WECHSELN      V1% =  INK       INK CFG%(2)      REPEAT        VADD LW%, 1       IF LW% = 31 THEN LW% = 8       PRINTXY 19, 24,  PADR$( 2,  STR$( LW%));      UNTIL CALL CHECK_DRIVE(LW%)      DISK LW%      INK V1%      REFRESHINFOS% = 1      BREAK          CASE A% = 18: REM CTRL+R = RESTART      IF CALL SHOW_INFO("RESTART EDITOR?", -1) THEN RESTART       BREAK          CASE A% = 14: REM CTRL + N = NEXT PAGE      VADD TOPZEILE%, SCREENZEILEN%      IF TOPZEILE%+SCREENZEILEN% >= MAXZEILEN%       TOPZEILE% = MAXZEILEN%-SCREENZEILEN%      ENDIF       IF TOPZEILE%+YPOS% >= MAXZEILEN% THEN YPOS% = MAXZEILEN%-TOPZEILE%-1      CALL REFRESH_SCREEN()      REFRESHINFOS% = 1      BREAK          CASE A% = 16: REM CTRL + P = PREVIOUS PAGE      Y% = TOPZEILE%      VSUB TOPZEILE%, SCREENZEILEN%      IF TOPZEILE% < 0       TOPZEILE% = 0       VADD YPOS%, Y%       IF YPOS% >= SCREENZEILEN% THEN VSUB YPOS%, SCREENZEILEN%      ENDIF       CALL REFRESH_SCREEN()      REFRESHINFOS% = 1      BREAK      CASE A% = 28: REM CTRL + 3 = CHANGE FILE TYP      CFG%(13) =  NOT CFG%(13)      REFRESHINFOS% = -1      BREAK          CASE A% = 159: REM CTRL + 4 = DIRECTORY      CALL SPRITES_OFF()      IF REUEXISTS()       CALL REU_SAVECHARSET()       CHARSET IIF( CFG%(4), 1, 0)      ENDIF      V1% =  INK       INK CFG%(3)      SCRCLR       PRINTXY 0, 0, "DIRECTORY DRIVE#";LW%;" - 'S' TO STOP READING"      INK CFG%(2)      SCRWINDOW 0, 2, 40, 23      DIRECTORY       PRINT       PRINT "PRESS ANY KEY..."      GETKEY A$, 0      SCRWINDOW OFF       INK V1%      SCRCLR       IF REUEXISTS() THEN CALL REU_LOADCHARSET()      CALL SPRITES_ON()      CALL REFRESH_SCREEN()      REFRESHINFOS% = -1      BREAK      CASE A% = 156: REM CTRL + 5 = CHANGE FONT      CFG%(4) =  NOT CFG%(4)      CALL CREATE_FONT(0)      BREAK         CASE A% = 3: REM CTRL + C = CONFIG      CALL CONFIG()      INK CFG%(2)      SCRCLR       CALL REFRESH_SCREEN()      REFRESHINFOS% = 1      BREAK     ENDCASE     BREAK    REM    REM CTRL + SHIFT   REM    CASE KEYS% = 5    DOCASE      CASE A% = 12: REM CTRL+SHIFT+L = LOAD CONFIG      CFGNAME$ =  CALL GET_FILENAME("LOAD CONFIG: ", CFGNAME$)      IF NOT EMPTY( CFGNAME$)       CALL LOAD_CONFIG(CFGNAME$, 0)      ENDIF       CALL REFRESH_SCREEN()      REFRESHINFOS% = 1      BREAK          CASE A% = $13: REM CTRL+SHIFT+S = SAVE CONFIG      CFGNAME$ =  CALL GET_FILENAME("SAVE CONFIG: ", CFGNAME$)      IF NOT EMPTY( CFGNAME$)       CALL SAVE_CONFIG(CFGNAME$)      ENDIF       COLOR CFG%(0), CFG%(1)      CALL REFRESH_SCREEN()      REFRESHINFOS% = 1      BREAK      CASE A% = 13: REM CTRL + SHIFT + M = SET MARK      IF SPMARK%       SPMARK1% = ZEILE%      ELSE        SPMARK2% = ZEILE%       IF SPMARK2% < SPMARK2%        SP1% = -1        SP2% = -1       ELSE         SP1% =  MIN( SPMARK1%, SPMARK2%)        SP2% =  MAX( SPMARK1%, SPMARK2%)       ENDIF       ENDIF       SPMARK% =  NOT SPMARK%      BREAK         CASE A% = $15: REM CTRL + SHIFT + U = CLEAR MARK      SP1% = -1      SP2% = -1      BREAK      CASE A% = 3: REM CTRL + SHIFT + C = COPY MARK TEXT      IF (SP1% <= SP2%) AND SP1% >= 0       ADR% =  CALL GET_ADRESSE_ZEILE()       MAX% = SP2%-SP1%+1       IF ZEILE%+MAX% > MAXZEILEN% THEN MAX% = MAXZEILEN%-ZEILE%       RCOPY BASE%+SP1%*40, BASE%+(SP1%+MAX%)*40, ADR%       RCOPY LENADR%+SP1%, LENADR%+SP1%+MAX%, LENADR%+ZEILE%       CALL REFRESH_SCREEN()      ENDIF       BREAK          CASE A% = 4: REM CTRL + SHIFT + D = DELETE MARK TEXT      IF (SP1% <= SP2%) AND SP1% >= 0       IF CALL SHOW_INFO("DELETE MARKED TEXT, ARE YOU SURE?", -1)        IF SP2%+1 < MAXZEILEN%         RCOPY BASE%+(SP2%+1)*40, BASEEND%, BASE%+SP1%*40        ENDIF         FILL BASEEND%-(SP2%-SP1%+1)*40, BASEEND%-1, $20        FILL LENEND%-(SP2%-SP1%+1), LENEND%-1, 0        SP1% =  LET SP2% = -1        CALL REFRESH_SCREEN()       ENDIF       ENDIF       BREAK          CASE A% = 9: REM CTRL + SHIFT + I = OVERWRITE/INSERT      CFG%(14) =  NOT CFG%(14)      REFRESHINFOS% = 1      BREAK      REM CTRL + SHIFT + P = PREV WORD     CASE A% = 16      CALL REFRESH_SCREEN()      ADR% =  CALL GET_ADRESSE_SPALTE()      MIN% =  CALL GET_ADRESSE_ZEILE()      WHILE ADR% >= MIN% AND RPEEK( ADR%) <> $20:ADR%--: ENDWHILE       IF ADR% >= MIN%       WHILE ADR% >= MIN% AND RPEEK( ADR%) = $20:ADR%--: ENDWHILE       ENDIF             IF ADR% >= MIN%       WHILE ADR% >= MIN% AND RPEEK( ADR%) <> $20:ADR%--: ENDWHILE        ADR% =  MAX( MIN%, ADR%)      ENDIF             IF ADR% >= MIN%       XPOS% =  LET XP% = ADR%-MIN%+1      ENDIF       PRINTXY 10, 10,  HEX$( MIN%)      PRINTXY 10, 11,  HEX$( ADR%)      BREAK       X% = XPOS%      IF RPEEK( ADR%) <> $20       FOR X% = XPOS% TO 0 STEP -1        IF RPEEK( ADR%--) = $20 THEN ADR%++: EXIT        NEXT        PRINTXY 10, 10, "10-"; PADL$( 3,  STR$( X%))      ENDIF       IF X% >= 0       FOR X% = X% TO 0 STEP -1        IF RPEEK( ADR%--) = $20 THEN ADR%++: EXIT        NEXT        PRINTXY 10, 11, "11-"; PADL$( 3,  STR$( X%))      ENDIF       IF X% >= 0       FOR X% = X% TO 0 STEP -1        IF RPEEK( ADR%--) <> $20 THEN ADR%++: EXIT        NEXT        IF X% < 0 THEN X% = 0       PRINTXY 10, 12, "12-"; PADL$( 3,  STR$( X%))      ENDIF       XPOS% =  LET XP% = X%      REFRESHINFOS% = -1      BREAK      REM CTRL + SHIFT + N = NEXT WORD     CASE A% = 14      ADR% =  CALL GET_ADRESSE_SPALTE()      X% = XPOS%      IF RPEEK( ADR%) <> $20       FOR X% = XPOS% TO 39        IF RPEEK( ADR%++) = $20 THEN ADR%--: EXIT        NEXT       ENDIF       IF X% < 40       FOR X% = X% TO 39        IF RPEEK( ADR%++) <> $20 THEN EXIT        NEXT       ENDIF       IF X% >= 40       REM NAECHSTE NICHT LEERE ZEILE SUCHEN       IF ZEILE% < MAXZEILEN%-1        FOR Y% = ZEILE%+1 TO MAXZEILEN%-1         ADR% = BASE%+Y%*40+40         RTPOKE VARADDR( A$(0)),  SHIFTL( 8, ADR%)+$28         IF A$(0) <> LEER$ THEN EXIT         NEXT         IF ++Y% < MAXZEILEN%         YPOS% = Y%-TOPZEILE%         XPOS% = 0         WHILE RPEEK( ADR%++) = $20:XPOS%++: ENDWHILE         ENDIF         WHILE YPOS% >= SCREENZEILEN%         VSUB YPOS%, SCREENZEILEN%         VADD TOPZEILE%, SCREENZEILEN%        ENDWHILE                 CALL REFRESH_SCREEN()       ENDIF       ELSE        XPOS% = X%      ENDIF       XP% = XPOS%      REFRESHINFOS% = 1      BREAK     ENDCASE     BREAK    REM    REM CTRL + COMM   REM    CASE KEYS% = 6    DOCASE      CASE A% = $11: REM CTRL + COMMODORE + Q = QUIT EDITOR      IF CALL SHOW_INFO("QUIT EDITOR, ARE YOU SURE?", -1)       SETRAMROM 2       EDITOR       ENDIF       CALL REFRESH_SCREEN()      REFRESHINFOS% = 1      BREAK      CASE A% = 14: REM CTRL + SHIFT + N = NEW TEXT      IF CALL SHOW_INFO("NEW TEXT, ARE YOU SURE?", -1)       CALL NEW_TEXT()      ENDIF       CALL REFRESH_SCREEN()      REFRESHINFOS% = 1      BREAK     ENDCASE     BREAK  ENDCASE  BREAK  ENDCASE UNTIL REPEATPRINT TI%UNTILFUNCTION GET_STRING_FROM_ADR(V1%, MAXLEN%) RTPOKE VARADDR( A$(0)),  SHIFTL( 8, V1%)+MAXLEN% RETURN A$(0)ENDFUNC FUNCTION SHOW_HELP() SPLIT OFF  SCRCLR  RESTORE HELP TAB% = 0 REPEAT   INK CFG%(2)  A% =  READ   IF A% = -1 THEN EXIT   A$ =  UCASE$( READ )  B$ =  UCASE$( READ )  DOCASE    CASE A% = 0    PRINT     BREAK    CASE A% = 1    PRINT STRING$( VALINT( A$), B$)    BREAK    CASE A% = 2    PRINT UCASE$( A$)    BREAK    CASE A% = 3    FOR X% = 1 TO GETCSVCOUNT( A$, " ")     B$ =  GETCSVNUM$( X%, A$, " ")     INK CFG%(3+(B$ = "+"))     PRINT UCASE$( B$);" ";    NEXT     PRINT     BREAK    CASE A% = 4    TAB% =  NOT TAB%    BREAK    CASE A% = 5    IF NOT TAB%     PRINT UCASE$( "CTRL + ");A$;" = ";B$    ELSE      V1% =  POSX()      INK CFG%(3): PRINT UCASE$( A$);     INK CFG%(2): PRINT " "; UCASE$( B$);     IF V1% > 0      PRINT      ELSE       CURX 20     ENDIF     ENDIF     BREAK   ENDCASE  UNTIL  PRINT  PRINT UCASE$( "MAX LINES: "+ STR$( MAXZEILEN%)) PRINT STR$( FREE( 1))+ UCASE$( " FREE BYTES "); CURX 20; UCASE$( "PRESS ANY KEY...") IF REUEXISTS() THEN PRINT UCASE$( "REU SUPPORTED"); GETKEY A$, 0 SCRCLR  SPLIT ON ENDFUNC DATA HELPDATA 2, "PAB-EDIT V1.8  -  POWERED BY PABASIC", ""DATA 0, "", ""DATA 3, "CTRL +", ""DATA 4, "", ""DATA 5, "I", "INSERT LINE"DATA 5, "D", "DELETE LINE"DATA 5, "B", "CLR LINE TO BEGIN"DATA 5, "E", "CLR LINE TO END"DATA 5, "N", "NEXT PAGE"DATA 5, "P", "PREVIOUS PAGE"DATA 5, "L", "LOAD TEXT"DATA 5, "S", "SAVE TEXT"DATA 5, "1", "CHG DRIVE NUMBER"DATA 5, "3", "CHG FILE TYP"DATA 5, "4", "SHOW DIRECTORY"DATA 5, "5", "CHG FONT UC/LC"DATA 5, "R", "RESTART EDITOR"DATA 5, "U", "INSERT UMLAUTS"DATA 5, "C", "CONFIGURATION"DATA 5, "H", "HELP PAGE"DATA 4, "", ""DATA 0, "", ""DATA 3, "CTRL + SHIFT +", ""DATA 4, "", ""DATA 5, "M", "MARK START/END"DATA 5, "U", "CLEAR MARK"DATA 5, "C", "COPY MARK TEXT"DATA 5, "D", "DELETE MARK TEXT"DATA 5, "L", "LOAD CONFIG"DATA 5, "S", "SAVE CONFIG"DATA 5, "N", "NEXT WORD"DATA 5, "P", "PREVIOUS WORD"DATA 5, "I", "CHG OVERWR/INSERT"DATA 5, "", ""DATA 4, "", ""DATA 0, "", ""DATA 3, "CTRL + COMMODORE +", ""DATA 4, "", ""DATA 5, "N", "NEW TEXT"DATA 5, "Q", "QUIT EDITOR"DATA -1FUNCTION CONFIG_COLOR(V1%)  INK IIF( V1% = CY%, CFG%(3), CFG%(2))ENDFUNC FUNCTION CONFIG() FOR X% = 0 TO CFGSIZE%/2-1:CFG2%(X%) = CFG%(X%): NEXT  CALL REU_SAVECHARSET() CHARSET 1 SCRWINDOW 0, 0, 40, 25 SCRCHARS 4 SCRBOX 0, 0, 40, 25 INK CFG%(3) PRINTXY 4, 1, "ÃONFIGURATION" SCRWINDOW 1, 1, 38, 23 INK CFG%(2) SCRCLR  CX% = 10 LINIT% = 0 REPEAT   COLOR CFG%(0), CFG%(1)  PRINTXY 0, 1, ;  INK CFG%(2)  FOR Y% = 0 TO 3   INK IIF( Y% = CY%, CFG%(3), CFG%(2))   PRINT IIF( Y% = 0, "ÂORDER",  IIF( Y% = 1, "ÂACKGROUND",  IIF( Y% = 2, "ÔEXT", "ÓTATUS"))); CURX CX%; PADL$( 3,  STR$( CFG%(Y%)))  NEXT   CALL CONFIG_COLOR(4)  PRINT "ÕMLAUTS"; CURX CX%; IIF( CFG%(12), "YES", "NO ")  Y2% =  POSY() +1  FOR Y% = 0 TO 6   INK IIF( Y%+5 = CY%, CFG%(3), CFG%(2))   X% =  IIF( Y% < 4, 0, 15)   PRINTXY X%, Y2%+Y%- IIF( Y% < 4, 0, 3), UM_TEXT$(Y%); CURX CX%+X%; PADL$( 3,  STR$( CFG%(Y%+5)))  NEXT   CALL CONFIG_COLOR(12)  PRINT "ÃHARSET"; CURX CX%; IIF( CFG%(4), "ÕPPER/ÌOWER  ", "ÕPPER/ÓYMBOLS")  PRINT   CALL CONFIG_COLOR(13)  PRINT "FILETYPE"; CURX CX%; IIF( CFG%(13), "PRG", "SEQ")  CALL CONFIG_COLOR(14)  PRINT "TEXT MODE"; CURX CX%; IIF( CFG%(14), "OVERWRITE", "INSERT   ")  PRINT   CALL CONFIG_COLOR(15)  PRINT "ÅXIT"  PRINT   INK CFG%(2)  PRINT "ÃRSR ÕÐ/ÄÏ×Î TO NAVIGATE"  PRINT "ÃRSR ÌÅÆÔ/ÒÉÇÈÔ TO CHANGE VALUE"  PRINT "ÐRESS ËÅÙ AT ÓÓ/ÕMLAUTS TO SET VALUE"  PRINT "ÐRESS ÒÕÎ/ÓÔÏÐ TO ABORT"  GETKEY A%, 0    DOCASE    CASE A% = $11    CY% =  MIN( 15, ++CY%)    BREAK    CASE A% = $91    CY% =  MAX( 0, --CY%)    BREAK    CASE A% = $1D: REM RECHTS    IF CY% < 4     CFG%(CY%) = CFG%(CY%)+1     IF CFG%(CY%) = 16 THEN CFG%(CY%) = 0    ENDIF     IF CY% = 4 THEN CFG%(12) =  NOT CFG%(12):LINIT% = -1    IF CY% = 12 THEN CFG%(4) =  NOT CFG%(4):LINIT% = -1: REM CALL CREATE_FONT(-1)    IF CY% >= 5 AND CY% <= 11     CFG%(CY%) = CFG%(CY%)+1     IF CFG%(CY%) = 128 THEN CFG%(CY%) = 160     IF CFG%(CY%) = 256 THEN CFG%(CY%) = 32     IF CFG%(4) THEN LINIT% = -1    ENDIF         IF CY% >= 13 AND CY% <= 14 THEN CFG%(CY%) =  NOT CFG%(CY%)    BREAK    CASE A% = $9D: REM LINKS    IF CY% < 4     CFG%(CY%) = CFG%(CY%)-1     IF CFG%(CY%) < 0 THEN CFG%(CY%) = 15    ENDIF     IF CY% = 4 THEN CFG%(12) =  NOT CFG%(12):LINIT% = -1    IF CY% = 12 THEN CFG%(4) =  NOT CFG%(4):LINIT% = -1: REM CALL CREATE_FONT(-1)    IF CY% >= 5 AND CY% <= 11     CFG%(CY%) = CFG%(CY%)-1     IF CFG%(CY%) = 31 THEN CFG%(CY%) = 255     IF CFG%(CY%) = 159 THEN CFG%(CY%) = 127     IF CFG%(12) THEN LINIT% = -1    ENDIF     IF CY% >= 13 AND CY% <= 14 THEN CFG%(CY%) =  NOT CFG%(CY%)    BREAK    CASE (A% >= 32 AND A% < 128) OR A% >= 160    IF CY% >= 5 AND CY% <= 11     CFG%(CY%) = A%    ENDIF     BREAK    CASE A% = 3    FOR X% = 0 TO CFGSIZE%/2-1:CFG%(X%) = CFG2%(X%): NEXT     EXIT     BREAK         ENDCASE  UNTIL A% = $0D  INK CFG%(2) SCRWINDOW 0, 0, 40, 25 CALL INIT() INK CFG%(3) IF LINIT% OR NOT REUEXISTS()   PRINTXY 0, 24,  CHR$( $0F);"INIT CONFIG .. PLEASE WAIT ...";  CALL CREATE_FONT(1) ELSE   CALL REU_LOADCHARSET() ENDIF ENDFUNC 